---
// The site shell (#14, #21): the site name linking home, then the menu, on
// every page. The menu, Home first (#53), marks the section the page belongs to. The footer
// carries the build's "updated <date>" stamp (#26) and how to report a
// mistake (#19, #39).
import '../styles/swiss.css';
import { HOME_URL, MENU, NEW_ISSUE_URL } from '../lib/urls';
import { buildDate } from '../lib/current';
import { open } from '../lib/database';

interface Props {
  title: string;
}
const db = open();
const { title } = Astro.props;
const path = Astro.url.pathname;
const stamp = buildDate(db);
// Home is the home page alone; every other section is its path and below.
const isCurrent = (href: string) => (href === HOME_URL ? path === HOME_URL : path.startsWith(href));
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <title>{title} · The Fantasy League</title>
  </head>
  <body>
    <header class="top">
      <a class="logo" href={HOME_URL}>The Fantasy League</a>
      <nav aria-label="Sections">
        {MENU.map(({ href, label }) => <a href={href} aria-current={isCurrent(href) ? 'page' : undefined}>{label}</a>)}
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer class="bottom">
      <time class="updated" datetime={stamp.iso}>{stamp.text}</time>
      <p class="report">Spot a mistake? Tell a maintainer in the league chat or <a href={NEW_ISSUE_URL}>open an issue</a>.</p>
    </footer>
  </body>
</html>
