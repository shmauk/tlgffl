---
// Where a hand-recorded outcome comes from, when it isn't the games themselves:
// "recalled" is quiet grey text and "disputed" is red, bold and uppercase.
// Derived and confirmed outcomes need no note.
interface Props {
  source: 'derived' | 'confirmed' | 'recalled' | 'disputed';
}
const { source } = Astro.props;
---

{source === 'recalled' && <span class="src" title="From memory: no game record exists">recalled</span>}
{source === 'disputed' && <span class="src disp" title="Counts for nobody until the league settles it">Disputed</span>}
