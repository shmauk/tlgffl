---
// /records/<slug>/<era>/<phase>/ (#14, #30): a record's pre-rendered filter
// variants, only the combinations that make sense for it. Its default
// combination is /records/<slug>/ itself.
import RecordPage from '../../../../components/RecordPage.astro';
import { RECORDS, variants, type Era, type PhaseFilter, type RecordDef } from '../../../../lib/records/catalogue';
import { recordView } from '../../../../lib/records/records';
import { siteDb } from '../../../../lib/records/site';

export function getStaticPaths() {
  return RECORDS.flatMap((def) =>
    variants(def)
      .slice(1)
      .map(({ era, phase }) => ({ params: { slug: def.slug, era, phase }, props: { def, era, phase } })),
  );
}

const { def, era, phase } = Astro.props as { def: RecordDef; era: Era; phase: PhaseFilter };
---

<RecordPage view={recordView(siteDb, def, era, phase)} />
