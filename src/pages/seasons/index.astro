---
// The roll of honour (#24): every season's champion, runner-up, Shit Bowl
// winner and Mediocre Bowl winner, newest first.
import Base from '../../layouts/Base.astro';
import Row from '../../components/Row.astro';
import SeasonLink from '../../components/SeasonLink.astro';
import FranchiseLink from '../../components/FranchiseLink.astro';
import { rollOfHonour } from '../../lib/db';
---

<Base title="Seasons">
  <Row label="Seasons" sub="The roll of honour">
    <h1>Roll of honour</h1>
  </Row>
  <Row label="Every season">
    <table class="t">
      <thead>
        <tr><th>Season</th><th>Champion</th><th>Runner-up</th><th>Shit Bowl winner</th><th>Mediocre Bowl winner</th></tr>
      </thead>
      <tbody>
        {
          rollOfHonour().map(({ season, champion, runnerUp }) => (
            <tr>
              <td><SeasonLink season={season.year} /></td>
              <td>{champion && <FranchiseLink franchise={champion} teamName={champion.teamName} />}</td>
              <td>{runnerUp && <FranchiseLink franchise={runnerUp} teamName={runnerUp.teamName} />}</td>
              <td></td>
              <td></td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </Row>
</Base>
