---
// A placeholder so the menu's Seasons entry leads somewhere. /seasons/ becomes
// the roll of honour in a later ticket.
import Base from '../../layouts/Base.astro';
import Row from '../../components/Row.astro';
import SeasonLink from '../../components/SeasonLink.astro';
import { seasons } from '../../lib/db';
---

<Base title="Seasons">
  <Row label="Seasons" sub="The roll of honour is still to come">
    <h1>Seasons</h1>
  </Row>
  <Row label="Every season">
    <table class="t">
      <thead><tr><th>Season</th><th>Platform</th><th class="num">Teams</th></tr></thead>
      <tbody>
        {
          seasons().map((s) => (
            <tr>
              <td><SeasonLink season={s.year} /></td>
              <td>{s.era === 'nfl.com' ? 'NFL.com' : 'Sleeper'}</td>
              <td class="num">{s.teamCount}</td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </Row>
</Base>
