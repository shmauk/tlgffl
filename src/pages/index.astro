---
// / is the current season's hub (#14, #16, #35): its phase (regular season,
// brackets or off-season) is chosen from the data and the build date. No JS.
import Base from '../layouts/Base.astro';
import Row from '../components/Row.astro';
import Home from '../components/Home.astro';
import { homeData } from '../lib/home-db';
import { MENU } from '../lib/urls';
import { open } from '../lib/database';

const db = open();
const data = homeData(db);
---

<Base title="Home">
  {
    data ? (
      <Home data={data} />
    ) : (
      <Row label="The Fantasy League" sub="The record book, since 2012">
        <h1>The record book</h1>
      </Row>
    )
  }
  <Row label="Sections">
    {MENU.map(({ href, label }) => <p><a class="more" href={href}>{label} →</a></p>)}
  </Row>
</Base>
